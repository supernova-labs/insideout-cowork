{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insideout.local/schemas/mar-aberto/run-manifest-v4.schema.json",
  "title": "InsideOut Mar Aberto run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "project",
    "filter",
    "period",
    "status",
    "stage",
    "paths"
  ],
  "properties": {
    "contract_version": {
      "const": "4.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "filter": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "timezone": {
          "const": "America/Sao_Paulo"
        }
      }
    },
    "status": {
      "enum": [
        "created",
        "in_progress",
        "awaiting_login",
        "blocked_coverage",
        "awaiting_editorial_review",
        "completed",
        "failed"
      ]
    },
    "stage": {
      "enum": [
        "export",
        "collection",
        "analysis",
        "editorial_gate_1",
        "report",
        "complete"
      ]
    },
    "coverage_mode": {
      "enum": [
        "complete",
        "limited_approved"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:|/|\\\\|(?:.*[\\\\/])?\\.\\.(?:[\\\\/]|$)).+"
      },
      "properties": {
        "report": {
          "const": "deliverables/report.html"
        },
        "workbook": {
          "const": "deliverables/analytics.xlsx"
        },
        "report_template": {
          "const": "templates/report-template.html"
        },
        "analytics_template": {
          "const": "templates/analytics-template.xlsx"
        }
      }
    },
    "template_version": {
      "type": "string",
      "minLength": 1
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_template": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analytics_template": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "report": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analytics": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "template_version",
          "hashes"
        ],
        "properties": {
          "paths": {
            "required": [
              "report",
              "workbook",
              "report_template",
              "analytics_template"
            ]
          },
          "hashes": {
            "required": [
              "report",
              "analytics",
              "report_template",
              "analytics_template"
            ]
          }
        }
      }
    }
  ]
}
